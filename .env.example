# =========================================================
# movpick 환경 변수 (로컬 .env / Render 대시보드 공통)
#  - [Render 필수] 표시된 항목은 Render 백엔드 서비스에 반드시 등록
# =========================================================

# --- App ---
APP_ENV=development
# [Render 필수] JWT 서명 키 (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720
# [Render 필수] CORS 허용 Origin (콤마 구분)
FRONTEND_ORIGINS=http://localhost:5173,https://movpick.netlify.app,https://movpick.onrender.com,https://fsclass-n.github.io
# OAuth 로그인 완료 후 기본 복귀 프런트엔드 주소
FRONTEND_URL=http://localhost:5173
# [Render 필수] 백엔드 공개 주소 (OAuth redirect_uri 생성에 사용)
BACKEND_URL=http://localhost:8000

# --- Database (TiDB, MySQL 호환) ---
# DATABASE_URL 을 직접 지정하면 TIDB_* 값보다 우선합니다.
# 둘 다 비어 있으면 로컬 SQLite(backend/movpick.sqlite3)로 동작합니다.
DATABASE_URL=
# [Render 필수]
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB_NAME=movpick
# 비워두면 certifi CA 번들 사용
TIDB_SSL_CA=

# --- OAuth (콜백: {BACKEND_URL}/api/auth/oauth/{google|naver|kakao}/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오 REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- Test Login ---
DEMO_LOGIN_ENABLED=true

# --- RPA ---
RPA_ENABLED=true
# auto: 실제 사이트 시도 후 실패 시 모의 데이터 / real: 실제만 / mock: 모의만
RPA_MODE=auto
RPA_HEADLESS=true
RPA_TIMEOUT_SECONDS=20
CRAWL_INTERVAL_MINUTES=30
SEAT_MONITOR_INTERVAL_SECONDS=20
# 크롤링 사이 구간의 취소표/신규 예매를 시뮬레이션 (좌석 단위 데이터는 잔여석 수 기반 추정)
SEAT_SIMULATION=true
# (선택) 국내 프록시 경유 수집: http://user:pass@host:port
RPA_PROXY_URL=
# 원격 수집기(rpa.runner --push) 인증 토큰. 백엔드(Render)와 수집기 PC 의 .env 에 같은 값을 입력
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
RPA_INGEST_TOKEN=
# 서버에서 직접 수집하지 않고 원격 수집기 데이터를 사용하는 체인 (Render: cgv)
RPA_REMOTE_CHAINS=
# 실데이터 유효 시간(분). 이 시간 안에 갱신된 실데이터가 있으면 수집 실패 시에도 모의 데이터로 덮어쓰지 않음
RPA_REAL_TTL_MINUTES=180

# --- Notification Webhooks (선택) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend (Vite, 빌드 시점 주입) ---
VITE_API_URL=http://localhost:8000
